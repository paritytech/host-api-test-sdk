{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"],
  // `src/browser/**` is bundled into `dist/host/` by esbuild and must not be
  // emitted here as a second, unbundled copy of the same code. It is still type
  // checked: `tsconfig.browser.json` covers it, and `pnpm typecheck` runs both.
  "exclude": ["src/browser/**"]
}
